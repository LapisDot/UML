@startuml
class User {
    -Name: String
    -UserId: int
}

class TelegramBot {
    +receiveMessage(message: String)
    +analyzeComment(comment: String): AnalysisResult
    +sendResponse(result: AnalysisResult)
    +requestArticles(comment: String): List<Article>
    +sendArticles(articles: List<Article>)
}

class LLM {
    +requestAnalysis(comment: String): AnalysisResult
    +fetchArticles(comment: String): List<Article>
}

class AnalysisResult {
    -validity: Boolean
    +getSummary(): String
}

class Article {
    -title: String
    -url: String
    -stance: String
    +getSummary(): String
}

' Добавляем отношения создания
LLM --> AnalysisResult : creates
LLM --> Article : creates

User --> TelegramBot : sends comment
TelegramBot --> LLM : requests analysis
LLM --> TelegramBot : returns result
TelegramBot --> User : sends analysis result
TelegramBot --> LLM : requests articles
LLM --> TelegramBot : returns articles
TelegramBot --> User : sends articles (pro & con)
@enduml
